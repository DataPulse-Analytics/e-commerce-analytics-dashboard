            "summarizeBy": "none"
          }
        ],
        "lineageTag": "21a0175d-17f6-41b2-b5f7-4fa9b85991f3",
        "measures": [
          {
            "name": "Gross Sales",
            "expression": "SUM(Sales[total_purchase_amount])",
            "formatString": "#,0.00",
            "lineageTag": "051b85a4-c4da-4d67-b3ce-cd0fdd7d145c"
          },
          {
            "name": "Net Sales",
            "expression": "SUM(Sales[net_purchase_amount])",
            "formatString": "#,0.00",
            "lineageTag": "5232c566-4ad6-4c91-8810-9d3cd6db6535"
          },
          {
            "name": "Returned Purchase Value",
            "expression": "[Gross Sales] - [Net Sales]",
            "formatString": "#,0.00",
            "lineageTag": "19350163-4175-4cde-ad0c-bed5b28fe94a"
          },
          {
            "name": "Purchase Records",
            "expression": "COUNTROWS(Sales)",
            "formatString": "#,0",
            "lineageTag": "729f4be2-3b07-4be7-96d1-7d17bf954889"
          },
          {
            "name": "Customers",
            "expression": "DISTINCTCOUNT(Sales[customer_id])",
            "formatString": "#,0",
            "lineageTag": "9cf50406-93fc-4e83-8b35-971a0dc0ec21"
          },
          {
            "name": "Units",
            "expression": "SUM(Sales[quantity])",
            "formatString": "#,0",
            "lineageTag": "fd84df01-5e00-4641-96d0-a7072f098061"
          },
          {
            "name": "Average Purchase Value",
            "expression": "DIVIDE([Gross Sales], [Purchase Records])",
            "formatString": "#,0.00",
            "lineageTag": "82532fd2-338c-4879-b9b2-fb32d6fc6a8f"
          },
          {
            "name": "Returned Records",
            "expression": "CALCULATE([Purchase Records], Sales[returns] = 1)",
            "formatString": "#,0",
            "lineageTag": "20d520f4-017c-45bb-ab4e-6ff1bd516238"
          },
          {
            "name": "Return Rate",
            "expression": "DIVIDE([Returned Records], [Purchase Records])",
            "formatString": "0.0%",
            "lineageTag": "f379fa33-fb35-4bbc-bff2-86611fe89fde"
          },
          {
            "name": "Churned Customers",
            "expression": "CALCULATE([Customers], Sales[churn] = 1)",
            "formatString": "#,0",
            "lineageTag": "4029c33b-48fa-4ab9-90fc-ed19002f310d"
          },
          {
            "name": "Customer Churn Rate",
            "expression": "DIVIDE([Churned Customers], [Customers])",
            "formatString": "0.0%",
            "lineageTag": "a712b874-54ec-479b-a9ba-d2bf44518ca6"
          },
          {
            "name": "Net Sales per Customer",
            "expression": "DIVIDE([Net Sales], [Customers])",
            "formatString": "#,0.00",
            "lineageTag": "b3386361-0893-49b9-9bd3-aa9d82059b94"
          },
          {
            "name": "Calculated Line Item Value",
            "expression": "SUM(Sales[line_item_total])",
            "formatString": "#,0.00",
            "lineageTag": "cb48a6e7-85ad-466e-9512-851198e0891e"
          }
        ],
        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFilePath), [Delimiter=\",\", Columns=23, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"customer_id\", Int64.Type}, {\"purchase_date\", type datetime}, {\"product_category\", type text}, {\"product_price\", Int64.Type}, {\"quantity\", Int64.Type}, {\"total_purchase_amount\", Int64.Type}, {\"payment_method\", type text}, {\"customer_age\", Int64.Type}, {\"returns\", Int64.Type}, {\"customer_name\", type text}, {\"gender\", type text}, {\"churn\", Int64.Type}, {\"purchase_year\", Int64.Type}, {\"purchase_month\", Int64.Type}, {\"purchase_month_name\", type text}, {\"purchase_year_month\", type text}, {\"purchase_day_name\", type text}, {\"purchase_hour\", Int64.Type}, {\"line_item_total\", Int64.Type}, {\"net_purchase_amount\", Int64.Type}, {\"return_status\", type text}, {\"churn_status\", type text}, {\"age_group\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}